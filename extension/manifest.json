{
  "manifest_version": 3,
  "name": "AI 实时翻译",
  "version": "1.0.35",
  "description": "AI 实时翻译：网页翻译、视频字幕、TTS 播报、图片转文字",
  "permissions": ["activeTab", "storage", "scripting", "contextMenus", "downloads", "downloads.open"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI 实时翻译"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["floating-window.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["dict.js", "page-translate.js"],
      "css": ["page-translate.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["audio-processor.js", "app.html", "app.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
